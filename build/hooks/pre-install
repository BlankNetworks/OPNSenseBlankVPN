set -eu

if [ "${PKG_ROOTDIR:-/}" != / ] && [ "${PKG_CHROOTED:-}" != true ]; then
    echo "Install Blank VPN from within the target OPNsense system." >&2
    exit 1
fi

version_tool=/usr/local/sbin/opnsense-version
if [ ! -x "$version_tool" ] || [ "$("$version_tool" -n)" != opnsense ] ||
    [ "$("$version_tool" -a)" != 26.7 ] || [ "$(uname -m)" != amd64 ] ||
    [ ! -x /usr/bin/wg ] || [ ! -x /usr/local/sbin/dnsmasq ]; then
    echo "Blank VPN requires OPNsense Community Edition 26.7 on amd64 with WireGuard and Dnsmasq." >&2
    exit 1
fi
