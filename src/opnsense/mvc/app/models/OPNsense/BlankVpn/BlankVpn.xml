<model>
    <mount>//OPNsense/BlankVpn</mount>
    <version>1.8.0</version>
    <description>Blank VPN configuration and native object ownership</description>
    <items>
        <settings>
            <enabled type="BooleanField"><Default>0</Default></enabled>
            <interfaces type="TextField"/>
            <coverage type="TextField"><Default>device</Default></coverage>
            <networkMode type="TextField"><Default>disabled</Default></networkMode>
            <networkProfile type="TextField"/>
            <networkKillSwitch type="TextField"/>
            <strictInterfaces type="TextField"/>
            <smartInterfaces type="TextField"/>
            <smartAssignedOnly type="BooleanField"><Default>0</Default></smartAssignedOnly>
            <tailscaleInterfaces type="TextField"/>
            <localNetworks type="TextField"/>
            <dashboardBind type="TextField"><Default>lan</Default></dashboardBind>
            <hostname type="TextField"><Default>blankvpn.home.arpa</Default></hostname>
        </settings>
        <mullvadCatalog>
            <worldwide type="BooleanField"><Default>0</Default></worldwide>
            <countries type="TextField"/>
            <cities type="TextField"/>
        </mullvadCatalog>
        <profiles>
            <profile type="ArrayField">
                <name type="TextField"><Required>Y</Required></name>
                <relay type="TextField"/>
                <ownership type="TextField"><Required>Y</Required></ownership>
            </profile>
        </profiles>
        <nativeRoutes>
            <route type="ArrayField">
                <name type="TextField"><Required>Y</Required></name>
                <gatewayId type="TextField"><Required>Y</Required></gatewayId>
                <gatewayName type="TextField"><Required>Y</Required></gatewayName>
                <logicalInterface type="TextField"><Required>Y</Required></logicalInterface>
                <device type="TextField"><Required>Y</Required></device>
                <protocol type="TextField"><Required>Y</Required></protocol>
                <dns type="TextField"><Required>Y</Required></dns>
                <dnsPort type="IntegerField"><MinimumValue>46651</MinimumValue><MaximumValue>46706</MaximumValue><Required>Y</Required></dnsPort>
            </route>
        </nativeRoutes>
        <proxyRoutes>
            <route type="ArrayField">
                <name type="TextField"><Required>Y</Required></name>
                <node type="TextField"><Required>Y</Required></node>
                <core type="TextField"><Required>Y</Required></core>
                <protocol type="TextField"><Required>Y</Required></protocol>
                <slot type="IntegerField"><MinimumValue>0</MinimumValue><MaximumValue>7</MaximumValue><Required>Y</Required></slot>
            </route>
        </proxyRoutes>
        <assignments>
            <assignment type="ArrayField">
                <ip type="TextField"><Required>Y</Required></ip>
                <interface type="TextField"><Required>Y</Required></interface>
                <mac type="TextField"/>
                <ipv6 type="TextField"/>
                <kind type="TextField"/>
                <mode type="TextField"/>
                <label type="TextField"/>
                <profile type="TextField"/>
                <backup type="TextField"/>
                <killSwitch type="TextField"/>
                <failure type="OptionField">
                    <Default>block</Default>
                    <OptionValues>
                        <block>Block internet (IPv4 kill switch)</block>
                        <backup>Backup VPN</backup>
                        <wan>Normal internet</wan>
                    </OptionValues>
                </failure>
            </assignment>
        </assignments>
        <services>
            <service type="ArrayField">
                <name type="TextField"><Required>Y</Required></name>
                <domains type="TextField"><Required>Y</Required></domains>
                <profile type="TextField"/>
            </service>
        </services>
    </items>
</model>
